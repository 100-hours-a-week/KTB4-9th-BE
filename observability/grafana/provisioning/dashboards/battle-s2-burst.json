      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(k6_http_reqs_total{testid=~\"$testid\"})", "legendFormat": "누적 전체 요청", "refId": "A" },
        { "expr": "sum(k6_http_reqs_total{testid=~\"$testid\",operation=\"submit\"})", "legendFormat": "누적 제출 요청", "refId": "B" },
        { "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[1m]))", "legendFormat": "전체 RPS (1분 평균)", "refId": "C" },
        { "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\",operation=\"submit\"}[1m]))", "legendFormat": "제출 RPS (1분 평균)", "refId": "D" }
      ],
      "title": "k6 요청 수·처리량",
